APP_ENV=development
APP_NAME=LMS API
# Percent-encode special characters in the username/password portion of this URL.
DATABASE_URL=mysql+aiomysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>?charset=utf8mb4
JWT_SECRET=replace-with-a-random-secret
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
