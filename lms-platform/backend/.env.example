APP_ENV=development
APP_NAME=LMS API
# Percent-encode special characters in the username/password portion of this URL.
DATABASE_URL=mysql+aiomysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/lms?charset=utf8mb4
JWT_SECRET=replace-with-a-random-secret
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
PRIVATE_STORAGE_ROOT=../storage/private
MAX_UPLOAD_BYTES=26214400
EXPORT_MAX_ATTEMPTS=3
EXPORT_RETRY_BASE_SECONDS=2
EXPORT_TIMEOUT_SECONDS=120
DASHBOARD_CACHE_TTL_SECONDS=15
DASHBOARD_CACHE_MAX_ENTRIES=256
# Use development only for local/test EICAR checks. Staging/production require clamd.
FILE_SCAN_BACKEND=development
FILE_SCAN_HOST=127.0.0.1
FILE_SCAN_PORT=3310
FILE_SCAN_TIMEOUT_SECONDS=30
EMAIL_DELIVERY_ENABLED=false
EMAIL_WORKER_INTERVAL_SECONDS=5
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=30
SMTP_HOST=127.0.0.1
SMTP_PORT=25
# SMTP_USERNAME/SMTP_PASSWORD are optional and must stay outside Git.
EMAIL_FROM=no-reply@lms.local
METRICS_ENABLED=true
